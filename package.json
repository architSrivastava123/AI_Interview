{
  "name": "mockmate-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm --prefix server start\" \"npm --prefix client run dev\"",
    "dev:server": "npm --prefix server start",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
